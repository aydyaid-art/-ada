# انسخ هذا الملف إلى .env ثم عدّل القيم
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# كلمة مرور لحماية لوحة التحكم (مهمة جداً عند النشر على VPS)
APP_PASSWORD=

# أقل فترة انتظار مسموحة بين الفحوصات (بالثواني)
MIN_DELAY_SEC=5

# أقصى عدد فحوصات تُحفظ نتائجها في الذاكرة/القرص للتشغيل الواحد
MAX_KEEP=300

# اسمح بفحص عناوين شبكة داخلية مثل localhost (للتجربة المحلية فقط)
ALLOW_PRIVATE=false

# إذا استضفت الواجهة على دومين آخر (مثل InfinityFree) ضع دومينها هنا
# مثال: https://nasihuhmindhahab.ct.ws
CORS_ORIGIN=
